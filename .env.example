# Videmak settings. Run `bash deploy/setup.sh` to copy this to .env with fresh secrets.
# Everything below "Services" can also be set later in the app: Admin (signed in as an admin).

# --- Required -------------------------------------------------------------------------------
# The address people open. Links in emails and payment pages use it.
PUBLIC_URL=http://localhost:3000
# Comma-separated emails that become admins once their email is confirmed. Without email set
# up, sign up first, then run: docker compose exec server node dist/cli/admin-grant.js you@example.com
ADMIN_EMAILS=
# Shown when someone cannot sign in or reset a password (optional).
SUPPORT_EMAIL=
# Secrets (setup.sh fills these in). JWT_SECRET signs sign-ins; SETTINGS_KEY encrypts keys
# saved from the admin page. Keep them: changing them signs everyone out / loses saved keys.
POSTGRES_PASSWORD=
JWT_SECRET=
SETTINGS_KEY=

# --- Web address ----------------------------------------------------------------------------
# Port on this machine (plain HTTP). For HTTPS on a domain see deploy/compose.https.yml.
HTTP_PORT=3000
# SITE_ADDRESS=write.example.edu

# --- Services: one key for everything -------------------------------------------------------
# A Videmak Cloud key (https://videmak.net/developers) makes papers, full text, research tools,
# AI, reviews and exports work at once, paid in credits. Leave empty to bring your own below.
VIDEMAK_API_KEY=

# --- Or bring your own, one service at a time ------------------------------------------------
# AI: deepseek (default) | openai | anthropic | openrouter | ollama | videmak
LLM_PROVIDER=
LLM_API_KEY=
# LLM_MODEL=            fast model (autocomplete, edits, chat)
# LLM_REVIEW_MODEL=     stronger model for reviews
# LLM_BASE_URL=         for Ollama or another OpenAI-compatible server

# Papers: scholar (default; works without a key at lower limits) | videmak | openalex
# A free Scholar key adds full text and research tools: https://scholar.citedevidence.com/account/api-keys
PAPERS_PROVIDER=
SCHOLAR_API_KEY=
# Contact address sent to OpenAlex when it is used (their "polite pool").
OPENALEX_EMAIL=

# --- Files ----------------------------------------------------------------------------------
# local (default, a Docker volume) | wasabi | s3 (any S3-compatible: AWS, R2, B2, MinIO…)
STORAGE_PROVIDER=local
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=          s3 only
# S3_URL_STYLE=virtual  path for MinIO
# S3_PREFIX=

# --- Email (password reset, email confirmation) ----------------------------------------------
# smtp | resend; off when empty
MAIL_PROVIDER=
# MAIL_FROM="Videmak <hello@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# --- Payments (only if you sell plans or credits yourself) ----------------------------------
# Test keys work as they are. A live key (sk_live_…) also needs BILLING_LIVE=1.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_LIVE=

# --- Developer page ------------------------------------------------------------------------
# PUBLIC_API_URL=https://api.videmak.net
# GITHUB_URL=
